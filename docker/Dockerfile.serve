FROM python:3.12-slim-trixie AS base
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

FROM base AS builder
COPY requirements-serve.txt /tmp/
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --no-compile -r /tmp/requirements-serve.txt

FROM base AS runtime
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/NikitaMotiejatis/mlops-lab" \
      org.opencontainers.image.revision="${GIT_COMMIT}"
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GIT_COMMIT=${GIT_COMMIT} \
    GIT_PYTHON_REFRESH=quiet \
    MODEL_NAME=adult-income \
    MODEL_ALIAS=champion
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY src/serve.py ./src/serve.py
RUN useradd --create-home --uid 1000 mluser
USER mluser
EXPOSE 8080
CMD ["uvicorn", "src.serve:app", "--host", "0.0.0.0", "--port", "8080"]
